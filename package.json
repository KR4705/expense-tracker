{
  "name": "expense-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:validate": "node scripts/build-tokens.mjs --check",
    "dev": "npm run tokens && vite",
    "typecheck": "npm run tokens && tsc -b",
    "validate": "npm run tokens:validate && npm run typecheck",
    "build": "npm run validate && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
